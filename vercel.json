{
    "builds":  [
                   {
                       "config":  {
                                      "distDir":  "dist",
                                      "buildCommand":  "npm run build"
                                  },
                       "use":  "@vercel/static-build",
                       "src":  "package.json"
                   }
               ],
    "routes":  [
                   {
                       "handle":  "filesystem"
                   },
                   {
                       "src":  "/(.*)",
                       "dest":  "/index.html"
                   }
               ]
}
